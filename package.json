{
  "name": "meeting-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "Meeting Assistant monorepo",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"pnpm --filter meeting-assistant-api dev\" \"pnpm --filter web dev --host 127.0.0.1\"",
    "funasr:up": "docker compose -f docker-compose.funasr.yml up -d",
    "funasr:down": "docker compose -f docker-compose.funasr.yml down",
    "funasr:logs": "docker compose -f docker-compose.funasr.yml logs -f funasr",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:logs": "docker compose -f docker-compose.db.yml logs -f db",
    "db:setup": "pnpm --filter meeting-assistant-api db:setup",
    "build": "pnpm --filter meeting-assistant-api build && pnpm --filter web build",
    "lint": "pnpm --filter meeting-assistant-api lint && pnpm --filter web lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
